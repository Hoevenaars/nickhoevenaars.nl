{
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    {
      "source": "/finance",
      "destination": "https://temporary-agile-perseus-ukwx3em.vercel.app/finance"
    },
    {
      "source": "/finance/",
      "destination": "https://temporary-agile-perseus-ukwx3em.vercel.app/finance"
    },
    {
      "source": "/finance/:path*",
      "destination": "https://temporary-agile-perseus-ukwx3em.vercel.app/finance/:path*"
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
